# Copy to .env and adjust before deploying publicly.
ENVIRONMENT=development            # development | production (production enforces secret/CORS)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
OWNER_EMAILS=owner@example.com
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

# Public subscription billing (leave false for self-hosted / everything free)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
PUBLIC_BASE_URL=http://localhost:8000

# Processing
DEPTH_BACKEND=heuristic          # heuristic | depth_anything
POSE_BACKEND=auto                # auto | mediapipe | demo
MAX_WORKERS=2

# Durability & storage
REDIS_URL=redis://localhost:6379/0   # empty => in-process thread pool
QUEUE_BACKEND=auto                   # auto | thread | redis
STORAGE_BACKEND=local                # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
